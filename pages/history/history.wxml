<!--pages/history/history.wxml-->
<view class="page">

  <view class="empty" wx:if="{{!tasks.length && !loading}}">
    <text class="empty-icon">📄</text>
    <text class="empty-text">暂无生成记录</text>
    <text class="empty-sub">去「生成」页面创建第一条内容</text>
  </view>

  <view class="card" wx:for="{{tasks}}" wx:key="task_id"
    bindtap="goToResult" data-id="{{item.task_id}}">
    <view class="card-top">
      <text class="skeleton-preview">{{item.skeleton.slice(0,60)}}{{item.skeleton.length>60?'…':''}}</text>
      <view class="status-badge status-{{item.status}}">
        {{item.status === 'done' ? '完成' : item.status === 'running' ? '生成中' : '失败'}}
      </view>
    </view>
    <view class="card-meta">
      <text class="meta-tag">{{item.style}}</text>
      <text class="meta-sep">·</text>
      <text class="meta-tag">{{item.platforms.join('/')}}</text>
      <text class="meta-time">{{item.created_at.slice(0,16).replace('T',' ')}}</text>
    </view>
    <view class="card-actions" catchtap="">
      <text class="del-btn" catchtap="deleteTask" data-id="{{item.task_id}}">删除</text>
    </view>
  </view>

  <view class="list-footer" wx:if="{{tasks.length}}">
    <text wx:if="{{loading}}">加载中…</text>
    <text wx:elif="{{!hasMore}}">共 {{total}} 条记录</text>
  </view>

</view>
