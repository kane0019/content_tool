/* pages/history/history.wxss */
page { background: #F5F5F7; }
.page { padding: 20rpx 24rpx; min-height: 100vh; }

/* Empty */
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; color: #1C1C1E; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #8E8E93; }

/* Card */
.card { background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; }
.card-top { display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 16rpx; }
.skeleton-preview { flex: 1; font-size: 28rpx; color: #1C1C1E; line-height: 1.5;
  padding-right: 16rpx; }
.status-badge { font-size: 22rpx; border-radius: 8rpx; padding: 4rpx 14rpx;
  flex-shrink: 0; font-weight: 500; }
.status-done    { background: #E3F9EA; color: #34C759; }
.status-running { background: #EEF0FF; color: #576AFF; }
.status-failed  { background: #FFE5E5; color: #FF3B30; }

/* Meta */
.card-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.meta-tag { font-size: 22rpx; color: #8E8E93; }
.meta-sep { font-size: 22rpx; color: #C0C0C8; }
.meta-time { font-size: 22rpx; color: #C0C0C8; margin-left: auto; }

/* Actions */
.card-actions { margin-top: 16rpx; display: flex; justify-content: flex-end; }
.del-btn { font-size: 24rpx; color: #FF3B30; padding: 8rpx 0 8rpx 24rpx; }

/* Footer */
.list-footer { text-align: center; padding: 32rpx 0;
  font-size: 24rpx; color: #C0C0C8; }
